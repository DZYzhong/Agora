# Agora local production environment template.
#
# Copy the three bootstrap secrets into infra/.env (gitignored) — the compose
# file interpolates them via ${AGORA_BOOTSTRAP_*:?}; scripts/deploy_local.sh
# generates random values on first run. Never commit real secrets.
#
# AGORA_BOOTSTRAP_HUMAN_TOKEN=<random 40+ chars>
# AGORA_BOOTSTRAP_AGENT_TOKEN=<random 40+ chars>
# AGORA_BOOTSTRAP_CI_TOKEN=<random 40+ chars>
#
# Optional operator overrides (defaults shown):
#
# AGORA_ALLOWED_ORIGINS=http://127.0.0.1:3000   # extra CORS/CSRF origins, comma separated
# AGORA_WEB_ORIGIN=http://127.0.0.1:3000        # Origin the Web sends to the API
# AGORA_BACKUP_PASSPHRASE=<backup encryption passphrase>  # for encrypted backups
#
# Fixed by infra/docker-compose.yml (do not override):
#   AGORA_ENV=production
#   AGORA_DATABASE_URL=postgresql+psycopg://agora:agora@postgres:5432/agora
#   AGORA_API_URL=http://api:8000  (web/connector internal)
#   AGORA_BOOTSTRAP_ORG_ID=local-org
#   AGORA_WEB_HUMAN_TOKEN= (empty — the Web UI authenticates via cookie sessions)
